            flex-direction: row;
            height: 100vh; 
            overflow: hidden; 
            position: relative;
            font-size: var(--font-dynamic);
        }

        body::before {
            content: ""; 
            position: absolute; 
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: url('../image_0.png'); 
            background-repeat: no-repeat;
            background-position: center; 
            background-size: clamp(180px, 25vw, 280px) auto; 
            opacity: 0.06; 
            z-index: -1; 
            pointer-events: none;
        }

        .sidebar { 
            width: var(--sidebar-width); 
            background-color: var(--sidebar-bg); 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            padding-top: 15px; 
            border-right: 1px solid var(--border-color); 
            flex-shrink: 0; 
            box-shadow: 2px 0 10px rgba(0,0,0,0.5); 
            z-index: 10;
        }

        .nav-btn { 
            background: none; 
            border: none; 
            color: var(--text-main); 
