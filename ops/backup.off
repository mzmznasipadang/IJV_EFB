            flex-direction: column; 
            align-items: center; 
            transition: all 0.2s ease; 
            gap: 6px; 
        }

        .nav-btn span { font-size: 18px; }
        .nav-btn:hover, .nav-btn.active { background-color: var(--panel-bg); color: var(--accent); border-left: 4px solid var(--accent); }

        .main-content { flex-grow: 1; padding: var(--safe-padding); display: flex; flex-direction: column; overflow-y: auto; -webkit-overflow-scrolling: touch; }

        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: var(--safe-padding); flex-shrink: 0; gap: 15px; }
        .header h2 { font-size: clamp(18px, 2vw + 12px, 24px); font-weight: 600; }

        #clock { font-family: monospace; font-size: clamp(14px, 1.5vw + 10px, 18px); letter-spacing: 1px; background: #1a1a1a; padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border-color); }

        .module { background-color: var(--panel-bg); padding: var(--safe-padding); border-radius: var(--radius); max-width: 1200px; width: 100%; margin-bottom: 20px; display: none; flex-direction: column; box-shadow: 0 4px 15px rgba(0,0,0,0.3); border: 1px solid var(--border-color); }
        .module.active { display: flex; }

        .sub-module-content { display: none; flex-direction: column; gap: 15px; width: 100%; }
        .sub-module-content.active { display: flex; }
        .module h3 { margin-bottom: 15px; font-size: clamp(16px, 1.5vw + 10px, 20px); }

        .sub-navbar { display: flex; gap: 5px; background: var(--sub-nav-bg); padding: 6px; border-radius: 4px; margin-bottom: 15px; border: 1px solid var(--border-color); overflow-x: auto; white-space: nowrap; }
        .sub-nav-btn { background: none; border: none; color: var(--text-muted); padding: 8px 16px; font-size: 13px; font-weight: 500; cursor: pointer; border-radius: 4px; transition: 0.15s; }
        .sub-nav-btn:hover { color: #fff; background: #2d2d2d; }
        .sub-nav-btn.active { background: var(--accent); color: white; }

        .data-display { margin-top: 10px; padding: 15px; background-color: #080808; font-family: 'Courier New', Courier, monospace; border-left: 4px solid var(--accent); border-radius: 4px; overflow-x: auto; color: #adff2f; font-size: 13px; line-height: 1.5; white-space: pre-wrap; }
        button.action-btn { padding: 12px 20px; font-size: 15px; background-color: var(--accent); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; transition: background 0.2s ease; }
        button.action-btn:hover { background-color: #0056b3; }
        input[type="text"] { background-color: var(--input-bg); border: 1px solid var(--border-color); color: #fff; padding: 10px 15px; border-radius: 4px; font-size: 15px; }

        .manifest-table-wrapper { margin-top: 15px; overflow-x: auto; border: 1px solid var(--border-color); border-radius: var(--radius); }
        .manifest-table { width: 100%; border-collapse: collapse; font-size: 14px; text-align: left; }
        .manifest-table th, .manifest-table td { padding: 12px 15px; border-bottom: 1px solid var(--border-color); }
        .manifest-table th { background-color: var(--sub-nav-bg); color: var(--accent); text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
        .manifest-table tr:nth-child(even) { background-color: rgba(255, 255, 255, 0.02); }
        .manifest-badge { padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .badge-crew { background: rgba(0, 123, 255, 0.2); color: #007bff; border: 1px solid #007bff; }
        .badge-pax { background: rgba(40, 167, 69, 0.2); color: #28a745; border: 1px solid #28a745; }

        textarea { resize: none; font-family: monospace; font-size: 15px; height: 350px; width: 100%; padding: 12px; background: var(--input-bg); color: #fff; border: 1px solid var(--border-color); border-radius: var(--radius); }

        .split-container { display: flex; gap: var(--safe-padding); height: 70vh; margin-top: 5px; width: 100%; }
        .split-sidebar { width: 260px; background: #161616; padding: 15px; border-radius: 6px; border: 1px solid var(--border-color); overflow-y: auto; flex-shrink: 0; }
        .tree-folder-title { font-weight: bold; font-size: 12px; margin-top: 12px; margin-bottom: 6px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #222; padding-bottom: 3px; }
        .tree-file-link { padding: 8px 10px; font-size: 13px; color: #bbb; cursor: pointer; border-radius: 4px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: 0.1s; }
        .tree-file-link:hover, .tree-file-link.active { background: #2a2a2a; color: white; }
        .split-viewer { flex-grow: 1; background: #1e1e1e; border-radius: 6px; border: 1px solid var(--border-color); overflow: hidden; position: relative; }
        .split-viewer iframe { width: 100%; height: 100%; border: none; }
        .viewer-placeholder { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #666; font-size: 13px; font-weight: 500; text-transform: uppercase; text-align: center; width: 85%; }

        @media (max-width: 768px) {
            body { flex-direction: column; height: 100vh; }
            .sidebar { width: 100%; height: auto; flex-direction: row; padding-top: 0; border-right: none; border-bottom: 1px solid var(--border-color); overflow-x: auto; justify-content: flex-start; }
            .nav-btn { padding: 12px 18px; width: auto; flex-direction: row; font-size: 13px; gap: 8px; border-bottom: 3px solid transparent; }
            .nav-btn:hover, .nav-btn.active { border-bottom: 3px solid var(--accent); background-color: rgba(255,255,255,0.05); border-left:none; }
            .main-content { height: calc(100vh - 50px); }
            .header { flex-direction: column; align-items: flex-start; gap: 6px; }
            .split-container { flex-direction: column; height: auto; }
            .split-sidebar { width: 100%; max-height: 180px; }
            .split-viewer { height: 450px; width: 100%; }
        }
    </style>
</head>
