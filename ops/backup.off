    <script>
        const serverChecklistDirectory = <?php echo json_encode($structure); ?>;
        const serverChartsDirectory = <?php echo json_encode($chartsStructure); ?>;
        let commanderName = <?php echo json_encode($pilotName); ?>;
        let activePassengerCount = 124;

        const indoMaleFirst = ["Budi", "Joko", "Agus", "Andi", "Rizky", "Aditya", "Pratama", "Hidayat", "Saputra", "Eko", "Tri", "Wawan", "Hendra", "Aris", "Dimas", "Ahmad", "Ilham", "Guntur", "Fajar", "Rian", "Bambang", "Dedi", "Heri", "Roni", "Taufik", "Suryo", "Anwar", "Hafiz", "Reza", "Bayu", "Doni", "Farhan", "Kevin", "Rudi", "Cecep", "Asep", "Irfan", "Arie", "Dani", "Yusuf", "Hendro", "Setyo", "Teguh", "Gunadi", "Satria", "Bagus", "Fikri", "Zaki", "Rahmat", "Zul", "Akbar"];
        const indoFemaleFirst = ["Siti", "Sri", "Dian", "Putri", "Sari", "Kartika", "Dewi", "Aulia", "Megawati", "Indah", "Rina", "Anisa", "Fitri", "Yanti", "Eka", "Maya", "Dwi", "Novi", "Wulan", "Ayu", "Lestari", "Siska", "Citra", "Nadia", "Amalia", "Intan", "Gita", "Dina", "Melati", "Chandra", "Viona", "Tari", "Sarah", "Amanda", "Anggraini", "Bella", "Nanda", "Ratih", "Shinta", "Niken", "Pratiwi", "Utami", "Widya", "Endah", "Ratna", "Santi", "Siska", "Dwi", "Puspita", "Wati", "Mega"];
        const indoLastNames = ["Wijaya", "Kusuma", "Santoso", "Siregar", "Nasution", "Hutapea", "Prakasa", "Gunawan", "Sutrisno", "Wibowo", "Budiman", "Setiawan", "Utami", "Lestari", "Mulyono", "Suhendra", "Zulkarnain", "Tanjung", "Pane", "Siddiq", "Habibie", "Yudhoyono", "Simanjuntak", "Pangaribuan", "Lubis", "Pasaribu", "Ginting", "Sembiring", "Tarigan", "Prasetyo", "Nugroho", "Pramono", "Haryanto", "Sudarsono", "Wicaksono", "Saputro", "Kurniawan", "Saraswati", "Palupi", "Hartono", "Salim", "Widjaja", "Riady", "Makarim", "Thohir", "Sadikin", "Purnama", "Subagyo", "Pradipta", "Suwondo", "Wahyudi", "Laksana"];
        const foreignNamesDatabase = [{ name: "John Smith", nat: "United States" }, { name: "Hans Müller", nat: "Germany" }, { name: "Takashi Tanaka", nat: "Japan" }, { name: "David Campbell", nat: "United Kingdom" }, { name: "Chloe Laurent", nat: "France" }, { name: "Zhang Wei", nat: "China" }];

        window.addEventListener('DOMContentLoaded', () => {
            generateFlightManifestEngine();
            if(localStorage.getItem("efb_notes")) { 
                document.getElementById("scratchpad").value = localStorage.getItem("efb_notes"); 
            }
        });

        function generateFlightManifestEngine() {
            const tbody = document.getElementById('manifest-table-body');
            if(!tbody) return; tbody.innerHTML = '';
            let idCounter = 1;

            appendManifestRow(idCounter++, commanderName, "Captain (PIC)", "Indonesia", "badge-crew");
            appendManifestRow(idCounter++, "F/O " + getRandomIndoName('M'), "First Officer (SIC)", "Indonesia", "badge-crew");
            
            for(let i = 1; i <= 4; i++) {
                appendManifestRow(idCounter++, "FA " + getRandomIndoName('F'), "Flight Attendant", "Indonesia", "badge-crew");
            }
            for(let p = 1; p <= activePassengerCount; p++) {
                if(Math.random() > 0.90) {
                    let f = foreignNamesDatabase[Math.floor(Math.random() * foreignNamesDatabase.length)];
                    appendManifestRow(idCounter++, f.name, "Passenger", f.nat, "badge-pax");
                } else {
                    appendManifestRow(idCounter++, getRandomIndoName(), "Passenger", "Indonesia", "badge-pax");
                }
            }
        }

        function getRandomIndoName(gender = null) {
            let firstPool = (gender === 'M') ? indoMaleFirst : (gender === 'F' ? indoFemaleFirst : (Math.random() < 0.5 ? indoMaleFirst : indoFemaleFirst));
            return firstPool[Math.floor(Math.random() * firstPool.length)] + " " + indoLastNames[Math.floor(Math.random() * indoLastNames.length)];
        }

        function appendManifestRow(id, name, role, nationality, badgeClass) {
            const tbody = document.getElementById('manifest-table-body');
            const row = document.createElement('tr');
            row.innerHTML = `<td>#${id}</td><td><strong>${name}</strong></td><td><span class="manifest-badge ${badgeClass}">${role}</span></td><td>${nationality === "Indonesia" ? "🇮🇩" : "🌐"} ${nationality}</td>`;
            tbody.appendChild(row);
        }

        function buildDataTree(dataSource, containerId, viewerId, placeholderId) {
            const container = document.getElementById(containerId); container.innerHTML = '';
            dataSource.forEach(dir => {
                const title = document.createElement('div'); title.className = 'tree-folder-title'; title.textContent = `📁 ${dir.folder}`;
                container.appendChild(title);
                dir.files.forEach(file => {
                    const lnk = document.createElement('div'); lnk.className = 'tree-file-link'; lnk.textContent = `📄 ${file.name}`;
                    lnk.onclick = () => {
                        document.querySelectorAll(`#${containerId} .tree-file-link`).forEach(el => el.classList.remove('active'));
                        lnk.classList.add('active');
                        document.getElementById(placeholderId).style.display = 'none';
                        document.getElementById(viewerId).src = file.path;
                    };
                    container.appendChild(lnk);
                });
            });
        }

        function switchChartsSubTab(subTab) {
            document.querySelectorAll('#maps-module .sub-module-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('#maps-module .sub-nav-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(`charts-${subTab}-sub`).classList.add('active');
            document.getElementById(`subtab-btn-charts-${subTab}`).classList.add('active');
            if(subTab === 'server') buildDataTree(serverChartsDirectory, 'server-charts-tree', 'server-charts-viewer', 'server-charts-placeholder');
        }

        function switchPerfSubTab(subTab) {
            document.querySelectorAll('#perf-module .sub-module-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('#perf-module .sub-nav-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(`perf-${subTab}-sub`).classList.add('active');
            document.getElementById(`subtab-btn-perf-${subTab}`).classList.add('active');
        }

        function loadLocalChartFile(event) {
            const file = event.target.files[0];
            if (file && file.type === "application/pdf") {
                document.getElementById('local-charts-placeholder').style.display = 'none';
                document.getElementById('local-charts-viewer').src = URL.createObjectURL(file);
            }
        }

        function updateClock() { document.getElementById('clock').textContent = new Date().toISOString().substring(11, 19) + 'Z'; }
        setInterval(updateClock, 1000); updateClock();

        function switchTab(tab) {
            document.querySelectorAll('.module').forEach(m => m.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tab + '-module').classList.add('active');
            document.getElementById('nav-' + tab).classList.add('active');
            if(tab === 'chk') buildDataTree(serverChecklistDirectory, 'checklist-tree', 'checklist-pdf-viewer', 'viewer-placeholder');
        }

        function showDispatcher() { document.getElementById('ofp-selection-screen').style.display = 'none'; document.getElementById('ofp-loader-screen').style.display = 'block'; }
        function backToSelection() { document.getElementById('ofp-selection-screen').style.display = 'flex'; document.getElementById('ofp-loader-screen').style.display = 'none'; }
        function saveNotes() { localStorage.setItem("efb_notes", document.getElementById("scratchpad").value); }

        async function fetchWeather() {
            const icao = document.getElementById('icao-input').value.toUpperCase().trim();
            if (icao.length !== 4) return alert("Invalid ICAO Code.");
            document.getElementById('weather-output-container').style.display = 'block';
            
            try {
                const res = await fetch(`?proxy_weather=1&type=metar&icao=${icao}`);
                const data = await res.json();
                if(data && data[0]) {
                    document.getElementById('metar-output').textContent = data[0].rawOb || data[0].rawMETAR;
                    document.getElementById('metar-decoded').innerHTML = `<strong>Wind:</strong> ${data[0].wdir}° at ${data[0].wspd}KT | <strong>Temp:</strong> ${data[0].temp}°C`;
                }
                const tafRes = await fetch(`?proxy_weather=1&type=taf&icao=${icao}`);
                const tafData = await tafRes.json();
                if(tafData && tafData[0]) document.getElementById('taf-output').textContent = tafData[0].rawTAF;
            } catch(e) { console.error(e); }
        }

        function resolveField(root, key, fallback = "") {
            if (!root || root[key] === undefined) return fallback;
            if (typeof root[key] === 'object' && root[key] !== null && root[key].value !== undefined) return root[key].value;
            return root[key];
        }

        async function fetchSimBrief() {
            const user = document.getElementById('simbrief-user').value.trim();
            if (!user) return alert("Username required.");
            document.getElementById('ofp-status').textContent = "Syncing with SimBrief API...";
            
            try {
                const res = await fetch(`https://www.simbrief.com/api/xml.fetcher.php?username=${encodeURIComponent(user)}&json=v2`);
                const data = await res.json();
                let flightPlanText = data.text?.plan_html || data.text?.plan_text;
                
                const cleanCommander = commanderName.replace("Capt. ", "").toUpperCase();
                flightPlanText = flightPlanText.replace(/\b(CAPT|CAPTAIN|PIC)(?:\s*[\/:]\s*|\s+)([A-Z0-9\s\.\-\/]{2,30})/gi, `$1: ${cleanCommander}`);

                document.getElementById('ofp-data-container').innerHTML = flightPlanText;
                document.getElementById('ofp-data-container').style.display = 'block';
                document.getElementById('ofp-status').textContent = "OFP Updated Successfully.";
                
                activePassengerCount = parseInt(resolveField(data.general, 'passengers', '124'));
                generateFlightManifestEngine();

                let rawTlrBlock = data.text?.tlr_section || "";
                document.getElementById('p-to-raw-display').textContent = rawTlrBlock || "No TLR section found.";
            } catch (e) { document.getElementById('ofp-status').textContent = "Sync Error: " + e.message; }
        }
    </script>
</body>
</html>