            gap: 6px; 
        }

        .form-group label { 
            font-size: 11px; 
            text-transform: uppercase; 
            color: var(--text-muted); 
            letter-spacing: 0.5px; 
        }

        select, input[type="text"] { 
            padding: 12px; 
            font-size: 15px; 
            border: 1px solid #444; 
            border-radius: 4px; 
            background-color: var(--input-bg); 
            color: white; 
            width: 100%;
            height: 44px;
        }

        select:focus, input[type="text"]:focus { 
            border-color: var(--accent); 
            outline: none; 
        }

        select:disabled { 
            opacity: 0.65; 
            cursor: not-allowed; 
            color: #b5b5b5; 
            background-color: #0f0f0f;
        }

        /* Output Typography Displays */
        .perf-field { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            padding: 12px 0; 
            border-bottom: 1px solid #333; 
            font-size: 15px; 
        }

        .perf-field:last-child { border-bottom: none; }
        .res-val { font-family: monospace; font-size: 18px; font-weight: bold; color: var(--res-color); }

        /* Raw Data Displays */
        .data-display { 
            margin-top: 10px; 
            padding: 15px; 
            background-color: #080808; 
            font-family: 'Courier New', Courier, monospace; 
            border-left: 4px solid var(--accent); 
            border-radius: 4px; 
            overflow-x: auto; 
            color: #adff2f; 
            font-size: 13px; 
            line-height: 1.5;
            white-space: pre-wrap;
        }

        .data-display * { color: inherit !important; background: transparent !important; font-family: inherit !important; }

        .station-alert-banner {
            padding: 10px 15px;
            background: rgba(255, 159, 67, 0.15);
            border: 1px solid var(--warning-amber);
            border-radius: 4px;
            color: var(--warning-amber);
            font-size: 13px;
            font-weight: 500;
            margin-top: 15px;
            display: none;
        }

        button.action-btn { 
            padding: 12px 20px; 
            font-size: 15px; 
            background-color: var(--accent); 
            color: white; 
            border: none; 
            border-radius: 4px; 
            cursor: pointer; 
            font-weight: 500; 
            min-height: 44px; 
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease;
        }

        button.action-btn:hover { background-color: #0056b3; }

        /* Manifest Tables */
        .manifest-table-wrapper {
            margin-top: 15px;
            overflow-x: auto;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
        }

        .manifest-table {
