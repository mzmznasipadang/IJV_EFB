        }

        .sub-nav-btn:hover { color: #fff; background: #2d2d2d; }
        .sub-nav-btn.active { background: var(--accent); color: white; }

        /* Grid Layout Matrix */
        .perf-layout-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
            gap: var(--safe-padding); 
            margin-top: 10px; 
        }

