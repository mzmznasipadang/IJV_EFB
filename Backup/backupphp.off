        }

        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            display: flex; 
            flex-direction: row;
            height: 100vh; 
            overflow: hidden; 
            position: relative;
            font-size: var(--font-dynamic);
        }

        /* Access Gate Layer System Overlay */
        #system-gate-overlay {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: #0b0b0b;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .gate-panel {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 30px;
            max-width: 450px;
            width: 100%;
            box-shadow: 0 10px 30px rgba(0,0,0,0.7);
            text-align: center;
        }

        /* Watermark Background */
        body::before {
            content: ""; 
            position: absolute; 
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: url('image_0.png'); 
            background-repeat: no-repeat;
            background-position: center; 
            background-size: clamp(180px, 25vw, 280px) auto; 
            opacity: 0.06; 
            z-index: -1; 
            pointer-events: none;
        }

        /* Navigation Sidebar */
        .sidebar { 
            width: var(--sidebar-width); 
            background-color: var(--sidebar-bg); 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            padding-top: 15px; 
            border-right: 1px solid var(--border-color); 
            flex-shrink: 0; 
            box-shadow: 2px 0 10px rgba(0,0,0,0.5); 
            z-index: 10;
        }

        .nav-btn { 
            background: none; 
            border: none; 
            color: var(--text-main); 
            padding: 14px 0; 
            width: 100%; 
            cursor: pointer; 
            font-size: 11px; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            transition: all 0.2s ease; 
            gap: 6px; 
        }

        .nav-btn span {
            font-size: 18px;
        }

        .nav-btn:hover, .nav-btn.active { 
            background-color: var(--panel-bg); 
            color: var(--accent); 
            border-left: 4px solid var(--accent); 
        }

        /* Main Content Workspace */
        .main-content { 
            flex-grow: 1; 
            padding: var(--safe-padding); 
            display: flex; 
            flex-direction: column; 
            overflow-y: auto; 
            -webkit-overflow-scrolling: touch;
        }

        /* Header Area */
        .header { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            border-bottom: 1px solid var(--border-color); 
            padding-bottom: 10px; 
            margin-bottom: var(--safe-padding); 
            flex-shrink: 0; 
            gap: 15px;
        }

        .header h2 {
            font-size: clamp(18px, 2vw + 12px, 24px);
            font-weight: 600;
        }

        #clock { 
            font-family: monospace; 
            font-size: clamp(14px, 1.5vw + 10px, 18px); 
            letter-spacing: 1px; 
            background: #1a1a1a;
            padding: 4px 10px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
        }

        /* Standard Modules */
        .module { 
            background-color: var(--panel-bg); 
            padding: var(--safe-padding); 
            border-radius: var(--radius); 
            max-width: 1200px; 
            width: 100%; 
            margin-bottom: 20px; 
            display: none; 
            flex-direction: column; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.3); 
            border: 1px solid var(--border-color);
        }

        .module.active { 
            display: flex; 
        }

        .sub-module-content {
            display: none;
            flex-direction: column;
            gap: 15px;
            width: 100%;
        }

        .sub-module-content.active {
            display: flex;
        }

        .module h3 {
            margin-bottom: 15px;
            font-size: clamp(16px, 1.5vw + 10px, 20px);
        }

        /* Sub-Navigation Menus */
        .sub-navbar { 
            display: flex; 
            gap: 5px; 
            background: var(--sub-nav-bg); 
            padding: 6px; 
            border-radius: 4px; 
