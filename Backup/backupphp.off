    <style>
        :root {
            /* Color Palette */
            --bg-color: #121212;
            --sidebar-bg: rgba(30, 30, 30, 0.95);
            --text-main: #e0e0e0;
            --text-muted: #aaa;
            --accent: #007bff;
            --navigraph-red: #e32636;
            --panel-bg: rgba(45, 45, 45, 0.95);
            --card-bg: rgba(20, 20, 20, 0.6);
