                </div>
                <div style="flex: 1; min-width: 150px;">
                    <span style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Est. Takeoff Weight (TOW)</span>
                    <div style="font-size: 15px; font-weight: bold; color: var(--res-color); margin-top: 4px;"><span id="w-tow-kg">--- kg</span> | <span id="w-tow-t">--- T</span></div>
                </div>
                <div style="flex: 1; min-width: 150px;">
                    <span style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Est. Landing Weight (LDW)</span>
                    <div style="font-size: 15px; font-weight: bold; color: var(--res-color); margin-top: 4px;"><span id="w-ldw-kg">--- kg</span> | <span id="w-ldw-t">--- T</span></div>
                </div>
            </div>

            <div style="margin-bottom: 15px; padding: 15px; background: #181818; border-radius: 6px; border: 1px solid #333; display: flex; align-items: center; gap: 15px;">
                <div class="form-group" style="width: 100%; max-width: 400px; gap: 4px;">
                    <label style="color: var(--accent); font-weight: bold;">Airframe Fleet Architecture (Locked to SimBrief)</label>
                    <select id="p-global-aircraft" disabled>
                        <option value="airbus" selected>Airbus Standard (A318/A319/A320/A321/A330/A350)</option>
                        <option value="boeing">Boeing Standard (737/747/757/767/777/787)</option>
                        <option value="atr">ATR Turboprop Series (ATR 42 / ATR 72)</option>
