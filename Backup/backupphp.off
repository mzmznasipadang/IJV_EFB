        .tree-folder-title { font-weight: bold; font-size: 12px; margin-top: 12px; margin-bottom: 6px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #222; padding-bottom: 3px; }
        .tree-file-link { padding: 8px 10px; font-size: 13px; color: #bbb; cursor: pointer; border-radius: 4px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: 0.1s; }
        .tree-file-link:hover, .tree-file-link.active { background: #2a2a2a; color: white; }

        .split-viewer { 
            flex-grow: 1; 
            background: #1e1e1e; 
            border-radius: 6px; 
            border: 1px solid var(--border-color); 
            overflow: hidden; 
            position: relative; 
        }

        .split-viewer iframe { width: 100%; height: 100%; border: none; }
        .viewer-placeholder { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #666; font-size: 13px; font-weight: 500; text-transform: uppercase; text-align: center; width: 85%; }

        .auto-detect-badge { 
            padding: 12px var(--safe-padding); 
            background: #1c252e; 
            border: 1px solid var(--accent); 
            border-radius: var(--radius); 
            color: #00fa9a; 
            display: flex; 
            align-items: center; 
            justify-content: space-between; 
            font-weight: 500; 
            font-size: 13px; 
            margin-bottom: 15px; 
            gap: 10px; 
            flex-wrap: wrap;
        }

        @media (max-width: 768px) {
            body { flex-direction: column; height: 100vh; overflow: hidden; }
            .sidebar { width: 100%; height: auto; flex-direction: row; padding-top: 0; border-right: none; border-bottom: 1px solid var(--border-color); overflow-x: auto; justify-content: flex-start; white-space: nowrap; -webkit-overflow-scrolling: touch; box-shadow: 0 2px 8px rgba(0,0,0,0.4); }
            .sidebar::-webkit-scrollbar { display: none; }
            .nav-btn { padding: 12px 18px; width: auto; flex-direction: row; font-size: 13px; gap: 8px; flex-shrink: 0; border-left: none; border-bottom: 3px solid transparent; }
            .nav-btn span { font-size: 15px; }
            .nav-btn:hover, .nav-btn.active { border-left: none; border-bottom: 3px solid var(--accent); background-color: rgba(255,255,255,0.05); }
            .main-content { height: calc(100vh - 50px); overflow-y: auto; }
            .header { flex-direction: column; align-items: flex-start; gap: 6px; }
            .split-container { flex-direction: column; height: auto; }
            .split-sidebar { width: 100%; max-height: 180px; overflow-y: auto; }
            .split-viewer { height: 450px; width: 100%; }
            #weather-module div[style*="display: flex"] { flex-direction: column !important; gap: 10px !important; }
            #weather-module input[type="text"] { width: 100% !important; }
            #ofp-loader-screen > div { flex-direction: column !important; gap: 8px !important; }
        }
    </style>
</head>
