        function clearPerformanceAndManifestData() {
            // Reset weights UI components
            document.getElementById('w-zfw-kg').textContent = "--- kg";
            document.getElementById('w-zfw-t').textContent = "--- T";
            document.getElementById('w-tow-kg').textContent = "--- kg";
            document.getElementById('w-tow-t').textContent = "--- T";
            document.getElementById('w-ldw-kg').textContent = "--- kg";
            document.getElementById('w-ldw-t').textContent = "--- T";
            document.getElementById('p-weight-manifest-bar').style.display = 'none';

            // Reset performance values layout tracking
            document.getElementById('p-to-v1-ofp').textContent = "--- KT";
            document.getElementById('p-to-vr-ofp').textContent = "--- KT";
            document.getElementById('p-to-v2-ofp').textContent = "--- KT";
            document.getElementById('p-to-v1-res').textContent = "--- KT";
            document.getElementById('p-to-vr-res').textContent = "--- KT";
            document.getElementById('p-to-v2-res').textContent = "--- KT";
            document.getElementById('p-to-flex-res').textContent = "---";
            document.getElementById('p-ld-dist-res').textContent = "--- M";

            // Reset internal script variables back to stock
            baselineTakeoffSpeeds = { v1: 142, vr: 145, v2: 149 };
            baselineLandingDistance = 1720;

            // Purge manifest table view
            document.getElementById('manifest-table-body').innerHTML = '';
            
            // Revert engine detection bar banner state
            document.getElementById('p-detected-type-label').textContent = "STANDBY — READ REQS DETECTED FROM SIMBRIEF DISPATCH";
            const banner = document.getElementById('p-detection-banner');
            banner.style.background = "#1c252e"; 
            banner.style.borderColor = "#007bff";
        }

        function authorizeEfbAccess() {
            const nameInput = document.getElementById('pilot-sig-name').value.trim();
            if(!nameInput) return alert("Pilot Signature validation required to access operational modules.");
            
            commanderName = nameInput.startsWith("Capt.") ? nameInput : "Capt. " + nameInput;
            document.getElementById('system-gate-overlay').style.display = 'none';
            clearPerformanceAndManifestData();
            generateFlightManifestEngine();
        }

        function generateIndonesianName(gender = null) {
            let firstPool = (gender === 'M') ? indoMaleFirst : (gender === 'F' ? indoFemaleFirst : (Math.random() < 0.5 ? indoMaleFirst : indoFemaleFirst));
            const first = firstPool[Math.floor(Math.random() * firstPool.length)];
            const last = indoLastNames[Math.floor(Math.random() * indoLastNames.length)];
            return first + " " + last;
        }

        function generateFlightManifestEngine() {
            const tbody = document.getElementById('manifest-table-body');
            tbody.innerHTML = '';
            let idCounter = 101;

            appendManifestRow(idCounter++, commanderName, "Captain (PIC)", "Indonesia", "badge-crew");
            appendManifestRow(idCounter++, "F/O " + generateIndonesianName('M'), "First Officer (SIC)", "Indonesia", "badge-crew");
            
            const faCount = activePassengerCount > 100 ? 5 : 3;
            for(let i = 1; i <= faCount; i++) {
                let faGender = (Math.random() < 0.80) ? 'F' : 'M';
                appendManifestRow(idCounter++, "FA " + generateIndonesianName(faGender), `Flight Attendant #${i}`, "Indonesia", "badge-crew");
            }

            for(let p = 1; p <= activePassengerCount; p++) {
                let pName = (Math.random() > 0.88) ? "" : generateIndonesianName();
                let pNat = "Indonesia";

                if (pName === "") {
                    const foreignAsset = foreignNamesDatabase[Math.floor(Math.random() * foreignNamesDatabase.length)];
                    pName = foreignAsset.name; pNat = foreignAsset.nat;
                }
                appendManifestRow(idCounter++, pName, "Passenger", pNat, "badge-pax");
            }
        }

        function appendManifestRow(id, name, role, nationality, badgeClass) {
            const tbody = document.getElementById('manifest-table-body');
            if(!tbody) return;
            const row = document.createElement('tr');
            row.innerHTML = `
                <td style="font-family: monospace; font-weight: bold; color: #888;">#${id}</td>
                <td style="font-weight: 500;">${name}</td>
                <td><span class="manifest-badge ${badgeClass}">${role}</span></td>
                <td style="color: var(--text-muted); font-size:13px;">🇮🇩 ${nationality}</td>
            `;
            if (nationality !== "Indonesia") row.querySelector('td:last-child').textContent = `🌐 ${nationality}`;
            tbody.appendChild(row);
        }

        function syncAirframeArchitecture() {
            const selectedFleet = document.getElementById('p-global-aircraft').value;
            const toFlapsMenu = document.getElementById('p-to-flaps');
            const ldFlapsMenu = document.getElementById('p-ld-flaps');

            toFlapsMenu.innerHTML = ''; ldFlapsMenu.innerHTML = '';

            operationalFlapsProfiles[selectedFleet].takeoff.forEach(f => {
                let opt = document.createElement('option'); opt.value = f.val; opt.textContent = f.label;
                toFlapsMenu.appendChild(opt);
            });
            operationalFlapsProfiles[selectedFleet].landing.forEach(f => {
                let opt = document.createElement('option'); opt.value = f.val; opt.textContent = f.label;
                ldFlapsMenu.appendChild(opt);
            });

            calculateTakeoffPerformance();
            calculateLandingPerformance();
        }

        function buildDataTree(dataSource, containerId, viewerId, placeholderId) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            if (!dataSource || dataSource.length === 0) {
                container.innerHTML = `<div style="color:#666; font-size:12px; padding:10px; font-style:italic;">No files detected in directory.</div>`;
                return;
            }
            dataSource.forEach(dir => {
                const title = document.createElement('div'); title.className = 'tree-folder-title'; title.textContent = `📁 ${dir.folder}`;
                container.appendChild(title);
                dir.files.forEach(file => {
                    const lnk = document.createElement('div'); lnk.className = 'tree-file-link'; lnk.textContent = `📄 ${file.name}`;
                    lnk.onclick = () => {
                        document.querySelectorAll(`#${containerId} .tree-file-link`).forEach(el => el.classList.remove('active'));
                        lnk.classList.add('active');
                        document.getElementById(placeholderId).style.display = 'none';
                        document.getElementById(viewerId).src = file.path;
                    };
                    container.appendChild(lnk);
                });
            });
        }

        function switchChartsSubTab(subTab) {
            document.querySelectorAll('#maps-module .sub-module-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('#maps-module .sub-nav-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(`charts-${subTab}-sub`).classList.add('active');
            document.getElementById(`subtab-btn-charts-${subTab}`).classList.add('active');
            if(subTab === 'server') buildDataTree(serverChartsDirectory, 'server-charts-tree', 'server-charts-viewer', 'server-charts-placeholder');
        }

        function switchPerfSubTab(subTab) {
            document.querySelectorAll('#perf-module .sub-module-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('#perf-module .sub-nav-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(`perf-${subTab}-sub`).classList.add('active');
            document.getElementById(`subtab-btn-perf-${subTab}`).classList.add('active');
        }

        function calculateTakeoffPerformance() {
            const fleet = document.getElementById('p-global-aircraft').value;
            const flapValue = document.getElementById('p-to-flaps').value;
            const packValue = document.getElementById('p-to-packs').value;
            const thrustValue = document.getElementById('p-to-thrust').value;

            let modV1 = baselineTakeoffSpeeds.v1;
            let modVR = baselineTakeoffSpeeds.vr;
            let modV2 = baselineTakeoffSpeeds.v2;

            if (fleet === "airbus") {
                if (flapValue === "1") { modV1 += 2; modVR += 2; modV2 += 1; }
                else if (flapValue === "3") { modV1 -= 3; modVR -= 2; modV2 -= 2; }
            } else if (fleet === "boeing") {
                if (flapValue === "1") { modV1 += 5; modVR += 4; modV2 += 4; }
                else if (flapValue === "15") { modV1 -= 2; modVR -= 2; modV2 -= 1; }
                else if (flapValue === "25") { modV1 -= 5; modVR -= 4; modV2 -= 3; }
            } else if (fleet === "atr") {
                modV1 = Math.min(modV1, 115); modVR = Math.min(modVR, 118); modV2 = Math.min(modV2, 122);
            } else if (fleet === "fokker") {
                if (flapValue === "0") { modV1 += 4; modVR += 3; modV2 += 2; }
                else if (flapValue === "15") { modV1 -= 2; modVR -= 2; modV2 -= 1; }
            } else if (fleet === "mcdonnell") {
                if (flapValue === "11") { modV1 += 3; modVR += 2; modV2 += 2; }
                else if (flapValue === "22") { modV1 -= 4; modVR -= 4; modV2 -= 3; }
            }

            if (packValue === "OFF") { modV1 -= 1; modVR -= 1; }

            let flexTempDisplay = "---";
            if (thrustValue === "TOGA") {
                flexTempDisplay = "N/A (MAX POWER)";
            } else if (thrustValue === "FLEX") {
                let baseFlex = (fleet === "atr" || fleet === "fokker") ? 42 : 46; 
                if (packValue === "OFF") baseFlex += 4; 
                modV1 += 2; modVR += 1;
                flexTempDisplay = `+${baseFlex}°C`;
            }

            document.getElementById('p-to-v1-res').textContent = `${modV1} KT`;
            document.getElementById('p-to-vr-res').textContent = `${modVR} KT`;
            document.getElementById('p-to-v2-res').textContent = `${modV2} KT`;
            document.getElementById('p-to-flex-res').textContent = flexTempDisplay;
        }

        function calculateLandingPerformance() {
            const fleet = document.getElementById('p-global-aircraft').value;
            const flapValue = document.getElementById('p-ld-flaps').value;
            const revValue = document.getElementById('p-ld-rev').value;
            const brakeValue = document.getElementById('p-ld-brake').value;

            let finalDistance = baselineLandingDistance;

            if (fleet === "airbus") {
                if (flapValue === "3") finalDistance += 160;
            } else if (fleet === "boeing") {
                if (flapValue === "15") finalDistance += 290;
                else if (flapValue === "40") finalDistance -= 60;
            } else if (fleet === "atr") {
                finalDistance = Math.round(finalDistance * 0.65); 
                if (flapValue === "15") finalDistance += 140;
            } else if (fleet === "fokker") {
                if (flapValue === "25") finalDistance += 150;
            } else if (fleet === "mcdonnell") {
                if (flapValue === "28") finalDistance += 220;
                else if (flapValue === "50") finalDistance -= 80;
            }

            if (revValue === "IDLE") finalDistance += 120;
            else if (revValue === "INOP") finalDistance += 310;

            if (brakeValue === "OFF") finalDistance += 650;
            else if (brakeValue === "LO") finalDistance += 380;
            else if (brakeValue === "HI") finalDistance -= 280;

            document.getElementById('p-ld-dist-res').textContent = `${Math.round(finalDistance)} M`;
        }

        function loadLocalChartFile(event) {
            const file = event.target.files[0];
            if (file && file.type === "application/pdf") {
                const objectUrl = URL.createObjectURL(file);
                document.getElementById('local-charts-placeholder').style.display = 'none';
                document.getElementById('local-charts-viewer').src = objectUrl;
            } else {
                alert("Please select a valid local PDF file.");
            }
        }

        function updateClock() { document.getElementById('clock').textContent = new Date().toISOString().substring(11, 19) + 'Z'; }
        setInterval(updateClock, 1000); updateClock();

        function switchTab(tab) {
            document.querySelectorAll('.module').forEach(m => m.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tab + '-module').classList.add('active');
            document.getElementById('nav-' + tab).classList.add('active');
            
            if(tab === 'chk') buildDataTree(serverChecklistDirectory, 'checklist-tree', 'checklist-pdf-viewer', 'viewer-placeholder');

            const titles = { 
                'weather': 'Aviation Weather', 'maps': 'Electronic Charts Portal', 
                'ofp': 'SimBrief Operational Flight Plan', 'perf': 'Performance Analysis Matrix', 
                'manifest': 'Passenger & Crew Security Manifest', 'chk': 'Document Checklist Browser', 
                'notes': 'Pilot Scratchpad' 
            };
            document.getElementById('page-title').textContent = titles[tab];
        }

        function showDispatcher() {
            document.getElementById('ofp-selection-screen').style.display = 'none';
            document.getElementById('ofp-loader-screen').style.display = 'block';
        }

        function backToSelection() {
            document.getElementById('ofp-selection-screen').style.display = 'flex';
            document.getElementById('ofp-loader-screen').style.display = 'none';
        }

        window.onload = function() { 
            syncAirframeArchitecture();
            if(localStorage.getItem("efb_notes")) { document.getElementById("scratchpad").value = localStorage.getItem("efb_notes"); } 
        };
        function saveNotes() { localStorage.setItem("efb_notes", document.getElementById("scratchpad").value); }

        function fetchWeather() {
            const icao = document.getElementById('icao-input').value.toUpperCase().trim();
            if (icao.length !== 4) return alert("Please specify a valid 4-letter ICAO station.");
            
            const alertBanner = document.getElementById('weather-station-alert');
            const outputContainer = document.getElementById('weather-output-container');
            const metarBox = document.getElementById('metar-output');
            const tafBox = document.getElementById('taf-output');

            outputContainer.style.display = 'block'; alertBanner.style.display = 'none';
            metarBox.textContent = "Querying regional telemetry data...";
            tafBox.textContent = "Compiling complete TAFOR trend forecast variables...";

            setTimeout(() => {
                const day = new Date().getUTCDate().toString().padStart(2, '0');
                const hr = new Date().getUTCHours().toString().padStart(2, '0');
                let sourceStation = weatherStationRegistryFallbacks[icao] ? weatherStationRegistryFallbacks[icao] : icao;

                if (weatherStationRegistryFallbacks[icao]) {
                    alertBanner.innerHTML = `⚠️ <strong>STATION LOG NOTIFICATION:</strong> ${icao} does not have a dedicated meteorological equipment station. Weather data below is sourced via reporting hub <strong>${sourceStation}</strong>.`;
                    alertBanner.style.display = 'block';
                }

                let hrStart = parseInt(hr);
                let hrEnd = (hrStart + 24) % 24;
                let dayEnd = hrStart + 24 >= 24 ? parseInt(day) + 1 : parseInt(day);

                metarBox.textContent = `${sourceStation} ${day}${hrStart.toString().padStart(2, '0')}53Z 24014KT 9999 BKN035 FEW080 28/22 Q1013 NOSIG`;
                tafBox.textContent = `TAF ${sourceStation} ${day}${hrStart.toString().padStart(2, '0')}30Z ${day}${hrStart.toString().padStart(2, '0')}/${dayEnd.toString().padStart(2, '0')}${hrEnd.toString().padStart(2, '0')}\n` +
                                      `  24015KT 9999 BKN030 FEW100\n` +
                                      `  BECMG ${day}${String((hrStart+3)%24).padStart(2,'0')}/${day}${String((hrStart+5)%24).padStart(2,'0')} 26018G26KT BKN025\n` +
                                      `  TEMPO ${day}14/${day}18 4000 -RA TSRA FEW020CB BKN022\n` +
                                      `  FM${dayEnd.toString().padStart(2, '0')}0100Z 29010KT 9999 SCT030 SCT090\n` +
                                      `  BECMG ${dayEnd.toString().padStart(2, '0')}06/${dayEnd.toString().padStart(2, '0')}08 22008KT FEW030 NOSIG`;
            }, 600);
        }

        function resolveField(root, key, fallback = "") {
            if (!root || root[key] === undefined) return fallback;
            if (typeof root[key] === 'object' && root[key] !== null && root[key].value !== undefined) return root[key].value;
            return root[key];
        }

        async function fetchSimBrief() {
            const user = document.getElementById('simbrief-user').value.trim();
            const status = document.getElementById('ofp-status');
            const container = document.getElementById('ofp-data-container');
            if (!user) return alert("Pilot Identification missing.");
            
            status.textContent = "Connecting to SimBrief Core API Engine...";
            container.style.display = 'none';
            
            // Clear prior dataset to keep execution scope clear
            clearPerformanceAndManifestData();

            try {
                const res = await fetch(`https://www.simbrief.com/api/xml.fetcher.php?username=${encodeURIComponent(user)}&json=v2`);
                if (!res.ok) throw new Error(`HTTP Error Status: ${res.status}`);
                const data = await res.json();
                if (data.error) throw new Error(`SimBrief System Response: ${data.error}`);

                let flightPlanText = data.text?.plan_html || data.text?.plan_text;
                if (!flightPlanText) throw new Error("Log verification error: Could not load data files.");

                const dispatchersList = ["Zulfachri Harahap", "Alga Putra", "Gerry Soejatman", "Tristan Liu"];
                const selectedDispatcher = dispatchersList[Math.floor(Math.random() * dispatchersList.length)];
                const cleanCommander = commanderName.replace("Capt. ", "").toUpperCase();
                const cleanDispatcher = selectedDispatcher.toUpperCase();

                flightPlanText = flightPlanText.replace(/\b(CAPT|CAPTAIN|PIC)(?:\s*[\/:]\s*|\s+)([A-Z0-9\s\.\-\/]{2,30})(?=\s{2,}|\n|<)/gi, (m, label) => {
                    let separator = m.includes('/') ? '/' : (m.includes(':') ? ': ' : ' ');
                    return label + separator + cleanCommander;
                });
                flightPlanText = flightPlanText.replace(/\b(DISP|DISPATCHER)(?:\s*[\/:]\s*|\s+)([A-Z0-9\s\.\-\/]{2,30})(?=\s{2,}|\n|<)/gi, (m, label) => {
                    let separator = m.includes('/') ? '/' : (m.includes(':') ? ': ' : ' ');
                    return label + separator + cleanDispatcher;
                });

                container.innerHTML = flightPlanText;
                container.style.display = 'block';
                status.textContent = "Flight data loaded successfully.";

                const standardIcaoType = resolveField(data.aircraft, 'icaocode').toUpperCase();
                const cleanName = resolveField(data.aircraft, 'name').toUpperCase();
                const globalSelect = document.getElementById('p-global-aircraft');
                let detectedManufacturer = "boeing"; 
                let labelText = `AUTO-DETECTED RUNTIME: BOEING PROFILE ARCHITECTURE INITIALIZED [${standardIcaoType}]`;

                if (standardIcaoType.startsWith('A3') || standardIcaoType.startsWith('A2') || standardIcaoType.startsWith('A35') || standardIcaoType.startsWith('A38')) {
                    detectedManufacturer = 'airbus';
                    labelText = `AUTO-DETECTED RUNTIME: AIRBUS CONF SETTINGS INITIALIZED [${standardIcaoType} - ${cleanName}]`;
                } else if (standardIcaoType.startsWith('B7') || standardIcaoType.startsWith('B3') || standardIcaoType.startsWith('BC')) {
                    detectedManufacturer = 'boeing';
                    labelText = `AUTO-DETECTED RUNTIME: BOEING FLAPS SETTINGS INITIALIZED [${standardIcaoType} - ${cleanName}]`;
                } else if (standardIcaoType.startsWith('AT') || standardIcaoType.startsWith('ATR')) {
                    detectedManufacturer = 'atr';
                    labelText = `AUTO-DETECTED RUNTIME: ATR TURBOPROP PERFORMANCE ACTIVE [${standardIcaoType} - ${cleanName}]`;
                } else if (standardIcaoType.startsWith('F') && !standardIcaoType.startsWith('FA')) {
                    detectedManufacturer = 'fokker';
                    labelText = `AUTO-DETECTED RUNTIME: FOKKER SYSTEM ARCHITECTURE INITIALIZED [${standardIcaoType} - ${cleanName}]`;
                } else if (standardIcaoType.startsWith('MD') || standardIcaoType.startsWith('DC') || standardIcaoType === 'B712') {
                    detectedManufacturer = 'mcdonnell';
                    labelText = `AUTO-DETECTED RUNTIME: MCDONNELL DOUGLAS DIAL-A-FLAP ACTIVE [${standardIcaoType} - ${cleanName}]`;
                }

                globalSelect.value = detectedManufacturer;
                const banner = document.getElementById('p-detection-banner');
                banner.style.background = "#1b2a1e"; banner.style.borderColor = "#28a745";
                document.getElementById('p-detected-type-label').textContent = labelText;
                
                let weightUnit = resolveField(data.params, 'weight_unit', 'kgs').toLowerCase();
                let estZFW = parseFloat(resolveField(data.weights, 'est_zfw', '0'));
                let estTOW = parseFloat(resolveField(data.weights, 'est_tow', '0'));
                let estLDW = parseFloat(resolveField(data.weights, 'est_ldw', '0'));

                if (weightUnit === 'lbs') {
                    estZFW = Math.round(estZFW * 0.45359237);
                    estTOW = Math.round(estTOW * 0.45359237);
                    estLDW = Math.round(estLDW * 0.45359237);
                }

                document.getElementById('w-zfw-kg').textContent = estZFW.toLocaleString() + " kg";
                document.getElementById('w-zfw-t').textContent = (estZFW / 1000).toFixed(2) + " T";
                document.getElementById('w-tow-kg').textContent = estTOW.toLocaleString() + " kg";
                document.getElementById('w-tow-t').textContent = (estTOW / 1000).toFixed(2) + " T";
                document.getElementById('w-ldw-kg').textContent = estLDW.toLocaleString() + " kg";
                document.getElementById('w-ldw-t').textContent = (estLDW / 1000).toFixed(2) + " T";
                document.getElementById('p-weight-manifest-bar').style.display = 'flex';

                activePassengerCount = parseInt(resolveField(data.general, 'passengers', '124'));
                generateFlightManifestEngine();

                // High-fidelity target parsing logic extraction array for V-speeds
                let ofpV1 = parseInt(resolveField(data.vspeeds, 'v1', 0));
                let ofpVR = parseInt(resolveField(data.vspeeds, 'vr', 0));
                let ofpV2 = parseInt(resolveField(data.vspeeds, 'v2', 0));

                // Fallback scan routine reading from structured flight plan blocks to clear data-mismatches
                if (!ofpV1 || !ofpVR || !ofpV2) {
                    const v1Match = flightPlanText.match(/\bV1\b[\s\.\:\/\=\-]+(\d{2,3})/i);
                    const vrMatch = flightPlanText.match(/\bVR\b[\s\.\:\/\=\-]+(\d{2,3})/i);
                    const v2Match = flightPlanText.match(/\bV2\b[\s\.\:\/\=\-]+(\d{2,3})/i);
                    
                    ofpV1 = v1Match ? parseInt(v1Match[1]) : (detectedManufacturer === 'atr' || detectedManufacturer === 'fokker' ? 112 : 142);
                    ofpVR = vrMatch ? parseInt(vrMatch[1]) : (detectedManufacturer === 'atr' || detectedManufacturer === 'fokker' ? 115 : 145);
                    ofpV2 = v2Match ? parseInt(v2Match[1]) : (detectedManufacturer === 'atr' || detectedManufacturer === 'fokker' ? 120 : 149);
                }

                baselineTakeoffSpeeds.v1 = ofpV1;
                baselineTakeoffSpeeds.vr = ofpVR;
                baselineTakeoffSpeeds.v2 = ofpV2;

                document.getElementById('p-to-v1-ofp').textContent = `${ofpV1} KT`;
                document.getElementById('p-to-vr-ofp').textContent = `${ofpVR} KT`;
                document.getElementById('p-to-v2-ofp').textContent = `${ofpV2} KT`;

                const baseElevation = parseInt(resolveField(data.destination, 'elevation', 0));
                baselineLandingDistance = baseElevation + (detectedManufacturer === 'atr' || detectedManufacturer === 'fokker' ? 1250 : 1720); 

                syncAirframeArchitecture();
                flightDataLoaded = true;

            } catch (e) {
                status.textContent = "Parsing Exception: " + e.message;
                console.error("EFB Diagnostic Trace:", e);
            }
        }
    </script>
</body>
</html>