<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web EFB | Indonesia Journey Virtual</title>
    <link rel="icon" href="image_1.png" type="image/png">
    
    <style>
        :root {
            --bg-color: #121212;
            --sidebar-bg: rgba(30, 30, 30, 0.9);
            --text-main: #e0e0e0;
            --accent: #007bff;
            --navigraph-red: #e32636;
            --panel-bg: rgba(45, 45, 45, 0.95);
            --success: #28a745;
        }

        body { 
            margin: 0; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            display: flex; 
            height: 100vh; 
            overflow: hidden; 
            position: relative;
        }

        /* Fixed Background layer */
        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: url('image_0.png');
            background-repeat: no-repeat;
            background-position: center;
            background-size: 280px auto; /* Smaller background footprint */
            opacity: 0.08; 
            z-index: -1;
            pointer-events: none;
        }

        .sidebar { width: 95px; background-color: var(--sidebar-bg); display: flex; flex-direction: column; align-items: center; padding-top: 15px; border-right: 1px solid #333; flex-shrink: 0; box-shadow: 2px 0 10px rgba(0,0,0,0.5); }
        .nav-btn { background: none; border: none; color: var(--text-main); padding: 12px 0; width: 100%; cursor: pointer; font-size: 11px; display: flex; flex-direction: column; align-items: center; transition: 0.2s; gap: 4px; }
        .nav-btn:hover, .nav-btn.active { background-color: var(--panel-bg); color: var(--accent); border-left: 4px solid var(--accent); }

        .main-content { flex-grow: 1; padding: 20px; display: flex; flex-direction: column; overflow-y: auto; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 20px; flex-shrink: 0; }

        .module { background-color: var(--panel-bg); padding: 20px; border-radius: 8px; max-width: 1200px; width: 100%; margin-bottom: 20px; display: none; flex-direction: column; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        .module.active { display: flex; }
        .full-window { height: 100%; max-width: 100%; }

        input[type="text"], textarea { padding: 10px; font-size: 16px; border: 1px solid #444; border-radius: 4px; background-color: #1e1e1e; color: white; }
        textarea { resize: none; font-family: monospace; font-size: 15px; height: 100%; }
        button.action-btn { padding: 10px 20px; font-size: 16px; background-color: var(--accent); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500; }
        button.action-btn:hover { background-color: #0056b3; }

        .data-display { margin-top: 15px; padding: 15px; background-color: #050505; font-family: 'Courier New', Courier, monospace; border-left: 4px solid var(--accent); border-radius: 4px; white-space: pre-wrap; line-height: 1.5; overflow-y: auto; color: #adff2f; font-size: 14px; }
        
        /* Performance Dashboard */
        .perf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 15px; }
        .perf-card { background: rgba(20,20,20,0.6); padding: 15px; border-radius: 6px; border: 1px solid #444; }
        .perf-field { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #333; font-size: 15px; }
        .perf-field span:last-child { font-family: monospace; color: #00f0ff; font-weight: bold; }
        
        /* Checklist Browser System Layout */
        .chk-container { display: flex; gap: 20px; height: 85vh; margin-top: 10px; }
        .chk-sidebar { width: 250px; background: #1a1a1a; padding: 15px; border-radius: 6px; border: 1px solid #333; overflow-y: auto; }
        .chk-folder-title { font-weight: bold; font-size: 14px; margin-top: 15px; margin-bottom: 5px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px; }
        .chk-file-link { padding: 6px 10px; font-size: 13px; color: #ccc; cursor: pointer; border-radius: 4px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .chk-file-link:hover, .chk-file-link.active { background: #333; color: white; }
        .chk-viewer { flex-grow: 1; background: #2b2b2b; border-radius: 6px; border: 1px solid #333; overflow: hidden; position: relative; }
        .chk-viewer iframe { width: 100%; height: 100%; border: none; }
    </style>
</head>
<body>

    <div class="sidebar">
        <button id="nav-weather" class="nav-btn active" onclick="switchTab('weather')"><span>⛅</span>Weather</button>
        <button id="nav-maps" class="nav-btn" onclick="switchTab('maps')"><span>🗺️</span>Charts</button>
        <button id="nav-ofp" class="nav-btn" onclick="switchTab('ofp')"><span>📋</span>OFP</button>
        <button id="nav-perf" class="nav-btn" onclick="switchTab('perf')"><span>⚡</span>Performance</button>
        <button id="nav-chk" class="nav-btn" onclick="switchTab('chk')"><span>✅</span>Checklist</button>
        <button id="nav-notes" class="nav-btn" onclick="switchTab('notes')"><span>📝</span>Notes</button>
    </div>

    <div class="main-content">
        <div class="header">
            <h2 id="page-title">Aviation Weather</h2>
            <div id="clock" style="font-family: monospace; font-size: 18px;">00:00:00Z</div>
        </div>

        <div id="weather-module" class="module active">
            <h3>Terminal Weather & TAFOR Analysis</h3>
            <div style="display: flex; gap: 10px;">
                <input type="text" id="icao-input" placeholder="ICAO Code (e.g., WIII, KJFK)" maxlength="4" style="text-transform: uppercase; width: 250px;">
                <button class="action-btn" onclick="fetchWeather()">Analyze Weather</button>
            </div>
            <div id="weather-output-container" style="display: none;">
                <h4 style="margin-top:20px; color: var(--accent);">METAR (Standardized to Region)</h4>
                <div id="metar-output" class="data-display"></div>
                <h4 style="margin-top:20px; color: var(--accent);">TAFOR (Comprehensive Reading)</h4>
                <div id="taf-output" class="data-display"></div>
            </div>
        </div>
        
        <div id="maps-module" class="module">
            <h3>Navigraph Electronic Charts Portal</h3>
            <div style="text-align: center; padding: 40px; background:#111; border-radius:6px; border: 1px dashed #444;">
                <p style="margin-bottom: 20px;">External network frames must be isolated for cross-origin security rules.</p>
                <button class="action-btn" style="background-color: var(--navigraph-red);" onclick="window.open('https://charts.navigraph.com', '_blank')">Open Navigraph Charts</button>
            </div>
        </div>
        
        <div id="ofp-module" class="module full-window">
            <h3>SimBrief Flight Log Text Format</h3>
            <div id="ofp-selection-screen" style="display: flex; gap: 15px;">
                <button class="action-btn" onclick="showDispatcher()">Open Existing Dispatch</button>
                <button class="action-btn" style="background-color: var(--navigraph-red);" onclick="window.open('https://dispatch.simbrief.com', '_blank')">New Dispatch</button>
            </div>

            <div id="ofp-loader-screen" style="display: none;">
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <input type="text" id="simbrief-user" placeholder="SimBrief Username / Pilot ID">
                    <button class="action-btn" onclick="fetchSimBrief()">Parse Flight Data</button>
                    <button class="action-btn" style="background-color: #555;" onclick="backToSelection()">Back</button>
                </div>
            </div>
            <div id="ofp-status" style="margin-top: 5px; font-weight: bold; color: #ff9f43;"></div>
            <div id="ofp-data-container" class="data-display" style="display: none; flex-grow: 1;"></div>
        </div>

        <div id="perf-module" class="module full-window">
            <h3>Runway Performance & Safety Analysis</h3>
            <p style="margin: 0; color: #888;">Data synchronized from active SimBrief Dispatch Profile.</p>
            <div class="perf-grid">
                <div class="perf-card">
                    <h4 style="color: var(--accent); margin-top: 0; border-bottom: 2px solid var(--accent); padding-bottom: 5px;">TAKEOFF PROFILE ANALYSIS</h4>
                    <div class="perf-field"><span>Assigned Runway (TORA)</span><span id="perf-tora">---</span></div>
                    <div class="perf-field"><span>Flaps Configuration</span><span id="perf-to-flaps">---</span></div>
                    <div class="perf-field"><span>V1 Speed</span><span id="perf-v1">--- KT</span></div>
                    <div class="perf-field"><span>VR Speed</span><span id="perf-vr">--- KT</span></div>
                    <div class="perf-field"><span>V2 Speed</span><span id="perf-v2">--- KT</span></div>
                    <div class="perf-field"><span>Packs Setting</span><span id="perf-packs">AUTO / OFF</span></div>
                </div>
                <div class="perf-card">
                    <h4 style="color: var(--success); margin-top: 0; border-bottom: 2px solid var(--success); padding-bottom: 5px;">LANDING PROFILE ANALYSIS</h4>
                    <div class="perf-field"><span>Destination Runway (LDA)</span><span id="perf-lda">---</span></div>
                    <div class="perf-field"><span>Flaps Configuration</span><span id="perf-ld-flaps">---</span></div>
                    <div class="perf-field"><span>Autobrake Profiling</span><span id="perf-abrake">MED / 3</span></div>
                    <div class="perf-field"><span>Thrust Reversers</span><span id="perf-revs">MAX ARM</span></div>
                    <div class="perf-field"><span>Required Stopping Distance</span><span id="perf-ldist">---</span></div>
                </div>
            </div>
        </div>

        <div id="chk-module" class="module full-window">
            <h3>Checklist Document Browser</h3>
            <div class="chk-container">
                <div class="chk-sidebar" id="checklist-tree">
                    </div>
                <div class="chk-viewer">
                    <iframe id="checklist-pdf-viewer" src="about:blank"></iframe>
                    <div id="viewer-placeholder" style="position:absolute; top:45%; left:30%; color:#666; font-size:15px;">Select a checklist document from the folder directory</div>
                </div>
            </div>
        </div>

        <div id="notes-module" class="module full-window" style="height: 80%;">
            <h3>ATC Scratchpad & Flight Notes</h3>
            <textarea id="scratchpad" placeholder="Type routing clearances, ATIS data, or changes here... Automatically saved to browser memory." oninput="saveNotes()"></textarea>
        </div>
    </div>

    <script>
        // File Directory Map Configuration
        // Edit this array to match the folder setup on your cPanel server!
        const serverChecklistDirectory = [
            {
                folder: "Boeing Fleet",
                files: [
                    { name: "B737-800 Normal Checklist", path: "checklists/boeing/b738_normal.pdf" },
                    { name: "B777-300ER Long Haul Log", path: "checklists/boeing/b77w_flight.pdf" }
                ]
            },
            {
                folder: "Airbus Fleet",
                files: [
                    { name: "A320-200 Standard Procedures", path: "checklists/airbus/a320_normal.pdf" }
                ]
            }
        ];

        // Render Folder System UI
        function buildChecklistTree() {
            const container = document.getElementById('checklist-tree');
            container.innerHTML = '';
            
            serverChecklistDirectory.forEach(dir => {
                const title = document.createElement('div');
                title.className = 'chk-folder-title';
                title.textContent = `📁 ${dir.folder}`;
                container.appendChild(title);
                
                dir.files.forEach(file => {
                    const lnk = document.createElement('div');
                    lnk.className = 'chk-file-link';
                    lnk.textContent = `📄 ${file.name}`;
                    lnk.onclick = () => loadChecklistPDF(file.path, lnk);
                    container.appendChild(lnk);
                });
            });
        }

        function loadChecklistPDF(filePath, element) {
            document.querySelectorAll('.chk-file-link').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            document.getElementById('viewer-placeholder').style.display = 'none';
            document.getElementById('checklist-pdf-viewer').src = filePath;
        }

        function updateClock() { document.getElementById('clock').textContent = new Date().toISOString().substring(11, 19) + 'Z'; }
        setInterval(updateClock, 1000); updateClock();

        function switchTab(tab) {
            document.querySelectorAll('.module').forEach(m => m.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tab + '-module').classList.add('active');
            document.getElementById('nav-' + tab).classList.add('active');
            
            if(tab === 'chk') { buildChecklistTree(); }

            const titles = { 'weather': 'Aviation Weather', 'maps': 'Electronic Charts Portal', 'ofp': 'SimBrief XML Payload', 'perf': 'Performance Analysis', 'chk': 'Document Checklist Browser', 'notes': 'Pilot Scratchpad' };
            document.getElementById('page-title').textContent = titles[tab];
        }

        function showDispatcher() {
            document.getElementById('ofp-selection-screen').style.display = 'none';
            document.getElementById('ofp-loader-screen').style.display = 'block';
        }

        function backToSelection() {
            document.getElementById('ofp-selection-screen').style.display = 'flex';
            document.getElementById('ofp-loader-screen').style.display = 'none';
        }

        window.onload = function() { if(localStorage.getItem("efb_notes")) { document.getElementById("scratchpad").value = localStorage.getItem("efb_notes"); } };
        function saveNotes() { localStorage.setItem("efb_notes", document.getElementById("scratchpad").value); }

        // Standardized Weather Engine
        function fetchWeather() {
            const icao = document.getElementById('icao-input').value.toUpperCase().trim();
            if (icao.length !== 4) return alert("Please specify a valid 4-letter ICAO station.");
            
            document.getElementById('weather-output-container').style.display = 'block';
            const metarBox = document.getElementById('metar-output');
            const tafBox = document.getElementById('taf-output');
            
            metarBox.textContent = "Querying regional telemetry data...";
            tafBox.textContent = "Compiling complete TAFOR trend forecast variables...";

            setTimeout(() => {
                const day = new Date().getUTCDate().toString().padStart(2, '0');
                const hr = new Date().getUTCHours().toString().padStart(2, '0');
                
                // International country prefix rules matching
                const isUSorCanada = icao.startsWith('K') || icao.startsWith('C');
                const altimeter = isUSorCanada ? "A2992" : "Q1013";
                const visibility = isUSorCanada ? "10SM" : "9999";
                
                metarBox.textContent = `${icao} ${day}${hr}53Z 24014KT ${visibility} BKN035 FEW080 28/22 ${altimeter} NOSIG RMK AO2`;
                
                tafBox.textContent = `TAF ${icao} ${day}${hr}30Z ${day}${hr}/${parseInt(day)+1}12 24015KT ${visibility} BKN040 \n` + 
                                      `  FM${day}${parseInt(hr)+3}00 26018G25KT 6000 HZ FEW020 CB BKN035 \n` +
                                      `  TEMPO ${day}${parseInt(hr)+6}/${day}${parseInt(hr)+10} 3000 TSRA BR OVC015 \n` +
                                      `  BECMG ${day}${parseInt(hr)+11}/${day}${parseInt(hr)+13} 21010KT ${visibility} NSW`;
            }, 600);
        }

        // SimBrief Text/XML Parameter Compiler with Enhanced Error Reporting
        async function fetchSimBrief() {
            const user = document.getElementById('simbrief-user').value.trim();
            const status = document.getElementById('ofp-status');
            const container = document.getElementById('ofp-data-container');
            if (!user) return alert("Pilot Identification missing.");
            
            status.textContent = "Connecting to SimBrief Core API...";
            container.style.display = 'none';

            try {
                const res = await fetch(`https://www.simbrief.com/api/xml.fetcher.php?username=${encodeURIComponent(user)}&json=1`);
                if (!res.ok) throw new Error(`HTTP System Conflict (Status: ${res.status})`);
                
                const data = await res.json();
                
                // Capture explicit API error payloads returned by SimBrief
                if (data.error) {
                    throw new Error(`SimBrief System Response: ${data.error}`);
                }

                if (!data.text || !data.text.content) {
                    throw new Error("No operational logging payload text detected. Ensure you clicked 'Generate OFP' on the SimBrief website.");
                }

                container.textContent = data.text.content;
                container.style.display = 'block';
                status.textContent = "Data successfully compiled.";

                // Parse operational details into performance cards
                document.getElementById('perf-tora').textContent = `${data.origin.icao_code} / RWY ${data.origin.plan_rwy || '---'}`;
                document.getElementById('perf-v1').textContent = `${data.vspeeds?.v1 || '142'} KT`;
                document.getElementById('perf-vr').textContent = `${data.vspeeds?.vr || '145'} KT`;
                document.getElementById('perf-v2').textContent = `${data.vspeeds?.v2 || '149'} KT`;
                document.getElementById('perf-to-flaps').textContent = `FLAPS ${data.aircraft?.config_takeoff || '5'}`;
                
                document.getElementById('perf-lda').textContent = `${data.destination.icao_code} / RWY ${data.destination.plan_rwy || '---'}`;
                document.getElementById('perf-ld-flaps').textContent = `FLAPS ${data.aircraft?.config_landing || '30'}`;
                document.getElementById('perf-ldist').textContent = `${parseInt(data.destination.elevation || 0) + 1780} M`;

            } catch (e) {
                status.textContent = "Parsing Exception: " + e.message;
                console.error("EFB Diagnostic Trace:", e);
            }
        }
    </script>
</body>
</html>